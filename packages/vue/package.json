{
  "name": "@fish-admin/vue",
  "version": "1.0.1",
  "description": "FishAdmin UI — Vue 3 components and design tokens for the FishAdmin admin template.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyingfishzxf/fish-admin.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/flyingfishzxf/fish-admin#readme",
  "bugs": {
    "url": "https://github.com/flyingfishzxf/fish-admin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "README.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/index.css": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm build:js && pnpm build:types && pnpm build:css",
    "build:js": "vite build",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:css": "pnpm --filter @fish-admin/tokens build && tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tanstack/vue-table": "^9.3.1",
    "@unovis/ts": "^1.5",
    "@unovis/vue": "^1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fish-admin/tokens": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
