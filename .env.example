# Enable the MSW mock API. Unset means: on for `pnpm dev`, off for `pnpm build`.
# Copy this file to `.env.local` to pin a value for both.
VITE_ENABLE_MOCK=true

# Simulated network latency for the mock API in milliseconds.
VITE_MOCK_LATENCY=300

# Base URL for API requests. Use /api with the built-in mocks, or point it at your backend.
VITE_API_BASE_URL=/api

# Absolute URL of the component documentation site. Unset hides the "Component docs"
# menu entry, the login-page link, and the redirects for the retired /components and
# /ui routes. Set it to your own deployment, or to https://fish-admin-docs.vercel.app.
VITE_DOCS_URL=

# Abort a request after this many milliseconds (1000-300000). Defaults to 15000.
VITE_REQUEST_TIMEOUT=15000

# Abort an attachment or asset upload after this many milliseconds (1000-600000). Defaults to 60000.
VITE_UPLOAD_TIMEOUT=60000
