{
  "name": "fish-admin",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "description": "MIT-licensed React and Vue 3 component libraries — 83 React and 90 Vue components — plus both RBAC admin templates.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.1.1",
  "scripts": {
    "scaffold": "node scripts/scaffold.mjs",
    "predev": "pnpm build:tokens",
    "dev": "vite",
    "prebuild": "pnpm build:tokens",
    "build": "tsc --noEmit && vite build",
    "prebuild:demo": "pnpm build:tokens",
    "build:demo": "cross-env VITE_ENABLE_MOCK=true vite build",
    "build:tokens": "pnpm --filter @fish-admin/tokens build",
    "check:tokens": "pnpm --filter @fish-admin/tokens check && node scripts/check-tokens.mjs",
    "audit:rtl": "node scripts/audit-rtl.mjs",
    "check:rtl": "node scripts/audit-rtl.mjs --check",
    "maturity": "node scripts/check-maturity.mjs",
    "check:maturity": "node scripts/check-maturity.mjs --check",
    "parity:freeze": "node scripts/parity-freeze.mjs",
    "check:parity:freeze": "node scripts/parity-freeze.mjs --check",
    "parity:contract": "node scripts/parity-contract.mjs",
    "check:parity:contract": "node scripts/parity-contract.mjs --check",
    "check:parity:scenarios": "node scripts/parity-scenarios.mjs",
    "test:tokens": "pnpm --filter @fish-admin/tokens test",
    "test:contracts": "pnpm --filter @fish-admin/contracts test",
    "test:i18n": "pnpm --filter @fish-admin/i18n test",
    "test:mock": "pnpm --filter @fish-admin/mock test",
    "test:shared": "pnpm --filter @fish-admin/contracts test && pnpm --filter @fish-admin/i18n test && pnpm --filter @fish-admin/mock test",
    "build:ui": "pnpm --filter @fish-admin/react build",
    "build:vue": "pnpm --filter @fish-admin/vue build",
    "build:vue-docs": "pnpm build:vue && pnpm --filter @fish-admin/parity-vue build",
    "dev:vue-docs": "pnpm --filter @fish-admin/parity-vue dev",
    "test:ui": "pnpm --filter @fish-admin/react test",
    "test:vue": "pnpm --filter @fish-admin/vue test && pnpm --filter @fish-admin/parity-vue test",
    "dev:landing": "pnpm --filter @fish-admin/landing dev",
    "build:landing": "pnpm build:tokens && pnpm --filter @fish-admin/landing build",
    "dev:vue-template": "pnpm --filter @fish-admin/vue-template dev",
    "build:vue-template": "pnpm --filter @fish-admin/vue-template build",
    "build:vue-template:demo": "pnpm build:vue && cross-env VITE_ENABLE_MOCK=true pnpm --filter @fish-admin/vue-template build",
    "test:vue-template": "pnpm --filter @fish-admin/vue-template test",
    "test:e2e:vue-template": "playwright test -c playwright.vue-template.config.ts",
    "check:package": "node scripts/check-package.mjs",
    "docs:dev": "pnpm --filter @fish-admin/docs dev",
    "docs:build": "pnpm --filter @fish-admin/docs build",
    "docs:preview": "pnpm --filter @fish-admin/docs preview",
    "docs:check": "pnpm --filter @fish-admin/docs check",
    "gen-api": "node scripts/gen-api.mjs",
    "gen-api:check": "node scripts/gen-api.mjs --check",
    "test:docs": "pnpm docs:build && playwright test -c playwright.docs.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && pnpm --filter @fish-admin/contracts typecheck && pnpm --filter @fish-admin/i18n typecheck && pnpm --filter @fish-admin/mock typecheck && pnpm --filter @fish-admin/tokens typecheck && pnpm --filter @fish-admin/react typecheck && pnpm --filter @fish-admin/vue typecheck && pnpm --filter @fish-admin/parity-vue typecheck && pnpm --filter @fish-admin/vue-template typecheck && pnpm --filter @fish-admin/landing typecheck && pnpm --filter @fish-admin/docs typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cross-env VITE_ENABLE_MOCK=true pnpm build && playwright test",
    "test:visual": "node scripts/check-visual-platform.mjs && playwright test -c playwright.visual.config.ts",
    "test:visual:update": "node scripts/check-visual-platform.mjs && playwright test -c playwright.visual.config.ts --update-snapshots=all",
    "test:visual:docker": "node scripts/visual-regression.mjs",
    "test:docs:visual": "node scripts/check-visual-platform.mjs pnpm test:docs:visual:docker && playwright test -c playwright.docs-visual.config.ts",
    "test:docs:visual:update": "node scripts/check-visual-platform.mjs pnpm test:docs:visual:docker && playwright test -c playwright.docs-visual.config.ts --update-snapshots=all",
    "test:docs:visual:docker": "node scripts/visual-regression-docs.mjs",
    "test:parity": "playwright test -c playwright.parity.config.ts",
    "test:parity:docker": "node scripts/parity-docker.mjs",
    "test:parity:vue": "cross-env PARITY_TARGET=vue node scripts/parity-docker.mjs",
    "test:vue-visual": "playwright test -c playwright.vue-visual.config.ts",
    "test:vue-visual:update": "playwright test -c playwright.vue-visual.config.ts --update-snapshots=all",
    "test:vue-visual:docker": "node scripts/vue-visual-docker.mjs",
    "test:vue-visual:docker:update": "node scripts/vue-visual-docker.mjs --update",
    "vue-visual:freeze": "node scripts/vue-visual-freeze.mjs",
    "check:vue-visual:freeze": "node scripts/vue-visual-freeze.mjs --check",
    "size": "pnpm build && node scripts/check-bundle-size.mjs",
    "perf": "playwright test e2e/perf.spec.ts",
    "msw:init": "msw init public --save",
    "prepare": "husky"
  },
  "dependencies": {
    "@fish-admin/contracts": "workspace:*",
    "@fish-admin/i18n": "workspace:*",
    "@fish-admin/mock": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^27.2.2",
    "i18next-resources-to-backend": "^1.2.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.60.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^18.0.3",
    "react-resizable-panels": "^4.14.8",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-docgen-typescript": "^2.4.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
