{
  "name": "@fish-admin/docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:template": "node scripts/sync-template-docs.mjs",
    "manifests": "node scripts/build-manifests.mjs",
    "predev": "pnpm manifests && pnpm sync:template && pnpm --filter @fish-admin/react build",
    "dev": "rspress dev",
    "prebuild": "pnpm manifests && pnpm sync:template && pnpm --filter @fish-admin/react build",
    "build": "rspress build",
    "preview": "rspress preview",
    "pretypecheck": "pnpm manifests && pnpm --filter @fish-admin/react build",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build-manifests.mjs --check && node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@fish-admin/react": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0"
  },
  "devDependencies": {
    "@rspress/core": "2.0.23",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
